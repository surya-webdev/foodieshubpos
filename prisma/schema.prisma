generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model starters {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?  @default("")
  type       String?  @default("veg")
  price      Float?   @default(0) @db.Real
  typedish   String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model maincourse {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model soups {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user {
  created_at DateTime @default(now()) @db.Timestamptz(6)
  userName   String?  @unique
  password   String?
  id         String   @id @unique @db.Uuid
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dashboard {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  day        DateTime @default(now()) @db.Date
  sale       Float    @db.Real
  typedish   String   @default("")
  quantity   Float    @default(1)
}

model bbq {
  created_at DateTime @default(now()) @db.Timestamptz(6)
  typedish   String?
  name       String?
  price      Float?   @db.Real
  type       String?  @default("veg")
  id         BigInt   @id @default(autoincrement())
}

model bread {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

model biriyani {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

model gravy {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

model tiffin {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

model frequent {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  type       String?  @default("veg")
  typedish   String?
  price      Float?   @db.Real
}

model order {
  id    String @id @default(uuid())
  order Int    @default(0)
}
